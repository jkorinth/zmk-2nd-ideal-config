#define ZMK_POINTING_DEFAULT_SCRL_VAL 		100

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/status_led.h>
#include "keys_de.h"

/ {
    combos {
        compatible = "zmk,combos";

        combo_tilde {
            key-positions = <1 0>;
            bindings = <&kp TILDE>;
            timeout-ms = <20>;
        };

        combo_lparen {
            key-positions = <3 2>;
            bindings = <&kp LPAR>;
            timeout-ms = <20>;
        };

        combo_div {
            key-positions = <3 4>;
            bindings = <&kp FSLH>;
            timeout-ms = <20>;
        };

        combo_mul {
            key-positions = <6 5>;
            bindings = <&kp ASTERISK>;
            timeout-ms = <20>;
        };

        combo_rparen {
            key-positions = <7 6>;
            bindings = <&kp RPAR>;
            timeout-ms = <20>;
        };

        combo_eq {
            key-positions = <8 7>;
            bindings = <&kp EQUAL>;
            timeout-ms = <20>;
        };

        combo_bslh {
            key-positions = <30 31>;
            bindings = <&kp BSLH>;
            timeout-ms = <20>;
        };

        // row 2

        combo_lbrace {
            key-positions = <12 13>;
            bindings = <&kp LBRC>;
            timeout-ms = <20>;
        };

        combo_minus {
            key-positions = <14 13>;
            bindings = <&kp MINUS>;
            timeout-ms = <20>;
        };

        combo_plus {
            key-positions = <15 16>;
            bindings = <&kp PLUS>;
            timeout-ms = <20>;
        };

        combo_rbrace {
            key-positions = <16 17>;
            bindings = <&kp RBRC>;
            timeout-ms = <20>;
        };

        combo_amps {
            key-positions = <17 18>;
            bindings = <&kp AMPS>;
            timeout-ms = <20>;
        };

        combo_bktk {
            key-positions = <17 18 19>;
            bindings = <&kp GRAVE>;
            timeout-ms = <30>;
        };

        // row 3

        combo_lbracket {
            key-positions = <22 23>;
            bindings = <&kp LBKT>;
            timeout-ms = <20>;
        };

        combo_excl {
            key-positions = <23 24>;
            bindings = <&kp EXCL>;
            timeout-ms = <20>;
        };

        combo_pipe {
            key-positions = <27 28>;
            bindings = <&kp PIPE>;
            timeout-ms = <20>;
        };

        combo_rbracket {
            key-positions = <28 29>;
            bindings = <&kp RBKT>;
            timeout-ms = <20>;
        };

        combo_ul {
            key-positions = <29 30>;
            bindings = <&kp UNDER>;
            timeout-ms = <20>;
        };

        // home row mods

        combo_lshft {
            key-positions = <10 12>;
            bindings = <&ht_sticky LSHFT LSHFT>;
        };

        combo_rshft {
            key-positions = <17 19>;
            bindings = <&ht_sticky RSHFT RSHFT>;
        };

        combo_lctrl {
            key-positions = <11 13>;
            bindings = <&ht_sticky LCTRL LCTRL>;
        };

        combo_rctrl {
            key-positions = <16 18>;
            bindings = <&ht_sticky RCTRL RCTRL>;
        };

        combo_lgui {
            key-positions = <20 23>;
            bindings = <&ht_sticky LGUI LGUI>;
            timeout-ms = <30>;
        };

        combo_rgui {
            key-positions = <28 31>;
            bindings = <&ht_sticky RGUI RGUI>;
        };

        combo_lalt {
            key-positions = <10 13>;
            bindings = <&ht_sticky LALT LALT>;
        };

        combo_ralt {
            key-positions = <16 19>;
            bindings = <&ht_sticky RALT RALT>;
        };

        combo_bkspc {
            key-positions = <16 17 18>;
            bindings = <&kp BSPC>;
            timeout-ms = <30>;
        };

        combo_sqt {
            key-positions = <18 19>;
            bindings = <&kp SQT>;
            timeout-ms = <20>;
        };

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <11 12 13>;
            timeout-ms = <30>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <10 11 12>;
            timeout-ms = <30>;
        };

        combo_auml {
            bindings = <&kp DE_A_UMLAUT>;
            key-positions = <10 2>;
            timeout-ms = <30>;
        };

        combo_ouml {
            bindings = <&kp DE_O_UMLAUT>;
            key-positions = <8 2>;
            timeout-ms = <30>;
        };

        combo_uuml {
            bindings = <&kp DE_U_UMLAUT>;
            key-positions = <2 6>;
            timeout-ms = <30>;
        };

        combo_szlig {
            bindings = <&kp DE_SZ>;
            key-positions = <11 20>;
            timeout-ms = <30>;
        };

        combo_capslock {
            bindings = <&kp CLCK>;
            key-positions = <10 11 12 13>;
            timeout-ms = <30>;
        };

        combo_lbootloader {
            bindings = <&bootloader>;
            key-positions = <0 1 2 3>;
            timeout-ms = <30>;
        };

        combo_rbootloader {
            bindings = <&bootloader>;
            key-positions = <6 7 8 9>;
            timeout-ms = <20>;
        };
    };

    td_caps: td_caps {
        compatible = "zmk,behavior-tap-dance";
        #binding-cells = <0>;
        tapping-term-ms = <200>;
        bindings = <&kp Z>, <&caps_word>;
    };

    ht_sticky: ht_sticky {
        compatible = "zmk,behavior-hold-tap";
        bindings = <&kp>, <&sk>;

        #binding-cells = <2>;
        tapping-term-ms = <175>;
        flavor = "tap-preferred";
    };

    td_flayer: td_flayer {
        compatible = "zmk,behavior-tap-dance";
        #binding-cells = <0>;
        bindings = <&mo 1>, <&tog 2>;
    };

    behaviors {
        msc_vrt: msc_vrt {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <25>;
        };

        msc_hrz: msc_hrz {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <25>;
        };

#if ZMK_BEHAVIOR_OMIT(SLED)
        /omit-if-no-ref/
#endif
        sled: sled {
            compatible = "zmk,behavior-status-led";
            #binding-cells = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt N1 Q  &mt N2 W        &mt N3 E   &mt N4 R  &mt N5 T                                      &mt N6 Y    &mt N7 U  &mt N8 I   &mt N9 O    &mt N0 P
&kp A     &kp S           &kp D      &kp F     &kp G                                         &kp H       &kp J     &kp K      &kp L       &kp SEMI
&td_caps  &kp X           &kp C      &kp V     &kp B     &sled SL_TURN_ON                  &sled SL_TURN_OFF    &kp N       &kp M     &kp COMMA  &kp DOT     &kp FSLH

                                               &mo 1     &kp SPACE                &kp ENTER  &td_flayer
          &kp UP                                                                                                              &kp UP
&kp LEFT  &bt BT_CLR_ALL  &kp RIGHT                                                                                &kp LEFT   &kp K_MUTE  &kp RIGHT
          &kp DOWN                                                                                                            &kp DOWN
            >;

            sensor-bindings = <&msc_hrz &msc_vrt>;
        };

        numbers_layer {
            bindings = <
&kp N1  &kp N2          &kp N3          &kp N4           &kp N5                                   &kp N6  &kp N7    &kp N8          &kp N9          &kp N0
&none   &mmv MOVE_LEFT  &mmv MOVE_UP    &mmv MOVE_RIGHT  &kp PG_UP                                &none   &kp LEFT  &kp UP          &kp RIGHT       &none
&none   &mkp RCLK       &mmv MOVE_DOWN  &mkp LCLK        &kp PG_DN  &trans                &trans  &none   &none     &kp DOWN        &none           &none

                                                         &trans     &trans                &trans  &tog 2
        &trans                                                                                                                      &mmv MOVE_UP
&trans  &trans          &trans                                                                                      &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT
        &trans                                                                                                                      &mmv MOVE_DOWN
            >;

            sensor-bindings = <&msc_hrz &msc_vrt>;
        };

        f_layer {
            bindings = <
&mt F11 F1  &mt F12 F2  &kp F3  &kp F4  &kp F5                                                  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&trans      &trans      &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans
&trans      &trans      &trans  &trans  &trans  &rgb_ug RGB_TOG                &rgb_ug RGB_EFF  &trans  &trans  &trans  &trans  &trans

                                        &trans  &trans                         &trans           &trans
            &trans                                                                                                      &kp N1
&trans      &bootloader &trans                                                                                  &kp N2  &kp N3       &kp N4
            &trans                                                                                                      &kp N5
            >;

            //sensor-bindings = <&rgb_hue &rgb_sat>;

            sensor-bindings = <&inc_dec_kp N9 N0>, <&inc_dec_kp X Y>;
        };
    };
};

&mt {
    tapping-term-ms = <300>;
    flavor = "tap-preferred";
};

&sk { release-after-ms = <5000>; };
